# Salin file ini menjadi .env untuk menjalankan backend lokal.
# JANGAN PERNAH commit file .env ke GitHub!

APP_ENV=development
APP_VERSION=0.1.0

# Ganti dengan string acak panjang (>= 32 karakter) di server deploy
JWT_SECRET_KEY=dev-only-change-this-secret-key-min-32-chars
JWT_EXPIRE_MINUTES=480

# Daftar origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kosongkan untuk mode memory lokal (seed otomatis).
# Isi PostgreSQL Connection String dari Supabase (Session/Transaction pooler) untuk mode database:
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# URL layanan ML terpisah (bagian AE - Faizah)
ML_SERVICE_URL=http://localhost:8001

# API key Gemini untuk ringkasan harian (dipanggil dari server saja, bukan frontend)
GEMINI_API_KEY=
